default_platform(:macos)

platform :macos do
  desc "Upload macOS build to App Store Connect"
  lane :upload_to_app_store do |options|
    key_content = options[:api_key_content]
    is_base64 = !key_content.include?("PRIVATE KEY")
    api_key = app_store_connect_api_key(
      key_id: options[:api_key_id],
      issuer_id: options[:api_issuer_id],
      key_content: key_content,
      is_key_content_base64: is_base64
    )

    deliver(
      pkg: options[:pkg],
      skip_waiting_for_build_processing: true,
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      api_key: api_key
    )
  end

  desc "Notarize macOS app"
  lane :notarize_app do |options|
    key_content = options[:api_key_content]
    is_base64 = !key_content.include?("PRIVATE KEY")
    api_key = app_store_connect_api_key(
      key_id: options[:api_key_id],
      issuer_id: options[:api_issuer_id],
      key_content: key_content,
      is_key_content_base64: is_base64
    )

    notarize(
      package: options[:package],
      bundle_id: "com.sabbirba.preconnect",
      api_key: api_key
    )
  end

  desc "Create a temporary keychain and import certificates"
  lane :setup_keychain do |options|
    keychain_name = "fastlane_tmp_keychain"
    keychain_password = "PreConnect"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    import_cert = lambda do |content, name_suffix|
      next if content.nil? || content.empty?
      
      is_base64 = !content.include?("PRIVATE KEY") && content.match?(/^[a-zA-Z0-9+\/=\s]+$/)
      p12_path = File.expand_path("~/temp_certificate_#{name_suffix}.p12")
      
      if is_base64
        require "base64"
        File.write(p12_path, Base64.decode64(content))
      else
        File.write(p12_path, content)
      end

      import_certificate(
        keychain_name: keychain_name,
        keychain_password: keychain_password,
        certificate_path: p12_path,
        certificate_password: options[:p12_password]
      )

      File.delete(p12_path) if File.exist?(p12_path)
    end

    import_cert.call(options[:p12_content], "app")
    import_cert.call(options[:installer_p12_content], "installer")
  end
end
