opt_out_usage

default_platform(:mac)

platform :mac do
  desc "Upload macOS build to App Store Connect"
  lane :upload_mac_to_app_store do |options|
    key_content = options[:api_key_content] || ENV["APP_STORE_CONNECT_API_KEY"]
    key_content = key_content.gsub("\\n", "\n") if key_content
    key_id = options[:api_key_id] || ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = options[:api_issuer_id] || ENV["APP_STORE_CONNECT_ISSUER_ID"]

    is_base64 = !key_content.include?("PRIVATE KEY")
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: is_base64
    )

    version_name = ENV["MACOS_VERSION_NAME"]
    version_code = ENV["MACOS_VERSION_CODE"]
    skip_upload = false
    if version_name && version_code
      begin
        latest_build = latest_testflight_build_number(
          version: version_name,
          platform: "osx",
          app_identifier: "com.sabbirba.preconnect",
          api_key: api_key
        )
        if latest_build && latest_build.to_i >= version_code.to_i
          UI.message("macOS build #{version_code} for version #{version_name} already exists on App Store Connect. Skipping binary upload.")
          skip_upload = true
        end
      rescue => e
        UI.message("Could not fetch latest macOS build: #{e.message}. Proceeding with upload.")
      end
    end

    release_notes = nil
    notes_path = File.expand_path("../../ios/fastlane/metadata/en-US/release_notes.txt", __dir__)
    if File.exist?(notes_path)
      release_notes = File.read(notes_path).strip
    end
    if release_notes.nil? || release_notes.empty?
      changelog_path = File.expand_path("../../CHANGELOG.md", __dir__)
      if File.exist?(changelog_path)
        content = File.read(changelog_path)
        match = content.match(/##\s*\[[0-9]+(?:\.[0-9]+)*\][^\n]*\n+([\s\S]*?)(?=\n+##\s*\[|\z)/)
        release_notes = match[1].strip if match && match[1]
      end
    end

    upload_kwargs = {
      pkg: skip_upload ? nil : options[:pkg],
      skip_binary_upload: skip_upload,
      platform: "osx",
      skip_metadata: false,
      skip_screenshots: true,
      force: true,
      reject_if_possible: true,
      submit_for_review: true,
      automatic_release: true,
      phased_release: false,
      run_precheck_before_submit: false,
      release_notes: {
        "en-US" => release_notes
      },
      submission_information: {
        export_compliance_uses_encryption: false
      },
      api_key: api_key
    }
    upload_kwargs[:app_version] = version_name if version_name && !version_name.to_s.empty?

    begin
      deliver(**upload_kwargs)
    rescue => e
      msg = e.message.to_s.downcase
      if msg.include?("already been used") || msg.include?("higher than") || msg.include?("already exists") || msg.include?("previously uploaded")
        UI.message("macOS build #{version_code} for version #{version_name} is already uploaded to App Store Connect. Skipping upload error.")
      elsif msg.include?("not in valid state") || msg.include?("cannot be reviewed") || msg.include?("whatsnew")
        UI.message("macOS package uploaded successfully to App Store Connect. Retrying submission without blocking: #{e.message}")
        upload_kwargs[:submit_for_review] = false
        deliver(**upload_kwargs) rescue UI.message("macOS release completed with warnings: #{e.message}")
      else
        UI.user_error!("Failed to upload/submit macOS app to App Store: #{e.message}")
      end
    end
  end

  desc "Notarize macOS app"
  lane :notarize_app do |options|
    key_content = options[:api_key_content] || ENV["APP_STORE_CONNECT_API_KEY"]
    key_content = key_content.gsub("\\n", "\n") if key_content
    key_id = options[:api_key_id] || ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = options[:api_issuer_id] || ENV["APP_STORE_CONNECT_ISSUER_ID"]

    is_base64 = !key_content.include?("PRIVATE KEY")
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: is_base64
    )

    notarize(
      package: options[:package],
      bundle_id: "com.sabbirba.preconnect",
      api_key: api_key,
      print_log: true,
      skip_stapling: true
    )
  end
end
