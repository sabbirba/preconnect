platform :ios, '26.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end

  target 'AlarmkitWidgetExtension' do
    inherit! :search_paths
    use_frameworks! :linkage => :static
    pod 'flutter_alarmkit', :path => '.symlinks/plugins/flutter_alarmkit/ios'
  end

end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['SWIFT_VERSION'] ||= '5.0'
      config.build_settings['CLANG_ENABLE_MODULE_VERIFIER'] = 'NO'
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      config.build_settings['OTHER_LIBRARIAN_FLAGS'] = '$(inherited) -no_warning_for_no_symbols'
      
      %w[LIBRARY_SEARCH_PATHS FRAMEWORK_SEARCH_PATHS].each do |key|
        paths = config.build_settings[key]
        if paths
          if paths.is_a?(Array)
            config.build_settings[key] = paths.reject { |p| p.include?('MetalToolchain') }
          elsif paths.is_a?(String)
            config.build_settings[key] = paths.split(' ').reject { |p| p.include?('MetalToolchain') }.join(' ')
          end
        end
      end

      if target.name == 'flutter_alarmkit'
        config.build_settings['EXCLUDED_SOURCE_FILE_NAMES'] = [
          'AlarmLiveActivityBundle.swift',
          'AlarmLiveActivity.swift',
          'AppIntents.swift'
        ].join(' ')
      end
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_PHOTOS_ADD_ONLY=0',
      ]
    end
    flutter_additional_ios_build_settings(target)
    
    target.build_phases.each do |phase|
      if phase.respond_to?(:files)
        phase.files.each do |file|
          if file.file_ref && file.file_ref.path && file.file_ref.path.end_with?('.xcprivacy')
            if phase.isa == 'PBXSourcesBuildPhase'
              phase.remove_build_file(file)
            end
          end
        end
      end
    end
  end

  installer.aggregate_targets.each do |target|
    target.xcconfigs.each do |config_name, xcconfig|
      %w[LIBRARY_SEARCH_PATHS FRAMEWORK_SEARCH_PATHS].each do |key|
        paths = xcconfig.attributes[key]
        if paths
          if paths.is_a?(Array)
            xcconfig.attributes[key] = paths.reject { |p| p.include?('MetalToolchain') }
          elsif paths.is_a?(String)
            xcconfig.attributes[key] = paths.split(' ').reject { |p| p.include?('MetalToolchain') }.join(' ')
          end
        end
      end
    end

    target_attributes = target.user_project.root_object.attributes['TargetAttributes'] || {}
    target.user_project.targets.each do |user_target|
      target_attributes[user_target.uuid] ||= {}
      target_attributes[user_target.uuid]['ProvisioningStyle'] = 'Manual'

      user_target.build_configurations.each do |config|
        config.build_settings['CODE_SIGN_STYLE'] = 'Manual'
        config.build_settings['SUPPORTED_PLATFORMS'] = 'iphoneos iphonesimulator'
        
        config.build_settings['DEVELOPMENT_TEAM'] = ''
        config.build_settings['DEVELOPMENT_TEAM[sdk=iphoneos*]'] = ''
        config.build_settings['DEVELOPMENT_TEAM[sdk=iphonesimulator*]'] = ''
        
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'YES'
        config.build_settings['CODE_SIGNING_ALLOWED[sdk=iphonesimulator*]'] = 'YES'
        config.build_settings['CODE_SIGNING_ALLOWED[sdk=iphoneos*]'] = 'YES'
        
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
        config.build_settings['CODE_SIGNING_REQUIRED[sdk=iphonesimulator*]'] = 'NO'
        config.build_settings['CODE_SIGNING_REQUIRED[sdk=iphoneos*]'] = 'NO'
        
        config.build_settings['AD_HOC_CODE_SIGNING_ALLOWED'] = 'YES'
        config.build_settings['AD_HOC_CODE_SIGNING_ALLOWED[sdk=iphonesimulator*]'] = 'YES'
        config.build_settings['AD_HOC_CODE_SIGNING_ALLOWED[sdk=iphoneos*]'] = 'YES'
        
        config.build_settings['PROVISIONING_PROFILE_REQUIRED'] = 'NO'
        config.build_settings['PROVISIONING_PROFILE_REQUIRED[sdk=iphonesimulator*]'] = 'NO'
        config.build_settings['PROVISIONING_PROFILE_REQUIRED[sdk=iphoneos*]'] = 'NO'
        
        config.build_settings['CODE_SIGN_IDENTITY'] = '-'
        config.build_settings['CODE_SIGN_IDENTITY[sdk=iphonesimulator*]'] = '-'
        config.build_settings['CODE_SIGN_IDENTITY[sdk=iphoneos*]'] = '-'
        
        config.build_settings['PROVISIONING_PROFILE'] = ''
        config.build_settings['PROVISIONING_PROFILE[sdk=iphoneos*]'] = ''
        config.build_settings['PROVISIONING_PROFILE[sdk=iphonesimulator*]'] = ''
        config.build_settings['PROVISIONING_PROFILE_SPECIFIER'] = ''
        config.build_settings['PROVISIONING_PROFILE_SPECIFIER[sdk=iphoneos*]'] = ''
        config.build_settings['PROVISIONING_PROFILE_SPECIFIER[sdk=iphonesimulator*]'] = ''

        if config.name == 'Debug'
          config.build_settings['CODE_SIGN_ENTITLEMENTS'] = ''
        end

        %w[LIBRARY_SEARCH_PATHS FRAMEWORK_SEARCH_PATHS].each do |key|
          paths = config.build_settings[key]
          if paths
            if paths.is_a?(Array)
              config.build_settings[key] = paths.reject { |p| p.include?('MetalToolchain') }
            elsif paths.is_a?(String)
              config.build_settings[key] = paths.split(' ').reject { |p| p.include?('MetalToolchain') }.join(' ')
            end
          end
        end
      end
    end
    target.user_project.root_object.attributes['TargetAttributes'] = target_attributes
    target.user_project.save
  end
end
