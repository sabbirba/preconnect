opt_out_usage

default_platform(:ios)

platform :ios do
  desc "Upload iOS build to TestFlight"
  lane :upload_build_to_testflight do |options|
    key_content = options[:api_key_content] || ENV["APP_STORE_CONNECT_API_KEY"]
    key_content = key_content.gsub("\\n", "\n") if key_content
    key_id = options[:api_key_id] || ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = options[:api_issuer_id] || ENV["APP_STORE_CONNECT_ISSUER_ID"]

    is_base64 = !key_content.include?("PRIVATE KEY")
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: is_base64
    )

    version_name = ENV["IOS_VERSION_NAME"]
    version_code = ENV["IOS_VERSION_CODE"]
    if version_name && version_code
      begin
        latest_build = latest_testflight_build_number(
          version: version_name,
          app_identifier: "com.sabbirba.preconnect",
          api_key: api_key
        )
        if latest_build && latest_build.to_i >= version_code.to_i
          UI.message("Build #{version_code} for version #{version_name} already exists on TestFlight (latest is #{latest_build}). Skipping upload.")
          next
        end
      rescue => e
        UI.message("Could not fetch latest TestFlight build: #{e.message}. Proceeding with upload.")
      end
    end

    begin
      upload_to_testflight(
        ipa: options[:ipa],
        skip_waiting_for_build_processing: true,
        api_key: api_key
      )
    rescue => e
      if e.message.include?("already been used") || e.message.include?("must be higher than the previously uploaded version")
        UI.message("Build already exists on TestFlight (duplicate). Skipping upload error.")
      else
        raise e
      end
    end
  end

  desc "Upload iOS build to App Store Connect and Submit for Review"
  lane :release_to_app_store do |options|
    key_content = options[:api_key_content] || ENV["APP_STORE_CONNECT_API_KEY"]
    key_content = key_content.gsub("\\n", "\n") if key_content
    key_id = options[:api_key_id] || ENV["APP_STORE_CONNECT_KEY_ID"]
    issuer_id = options[:api_issuer_id] || ENV["APP_STORE_CONNECT_ISSUER_ID"]

    is_base64 = !key_content.include?("PRIVATE KEY")
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: is_base64
    )

    version_name = ENV["IOS_VERSION_NAME"]
    version_code = ENV["IOS_VERSION_CODE"]
    skip_upload = false
    if version_name && version_code
      begin
        latest_build = latest_testflight_build_number(
          version: version_name,
          api_key: api_key
        )
        if latest_build && latest_build.to_i >= version_code.to_i
          UI.message("Build #{version_code} for version #{version_name} already exists on App Store Connect. Skipping binary upload.")
          skip_upload = true
        end
      rescue => e
        UI.message("Could not fetch latest TestFlight build: #{e.message}. Proceeding with upload.")
      end
    end

    release_notes = nil
    notes_path = File.join(__dir__, "metadata", "en-US", "release_notes.txt")
    if File.exist?(notes_path)
      release_notes = File.read(notes_path).strip
    end
    if release_notes.nil? || release_notes.empty?
      release_notes = "Bug fixes and performance improvements."
    end

    upload_kwargs = {
      ipa: skip_upload ? nil : options[:ipa],
      skip_binary_upload: skip_upload,
      skip_metadata: false,
      skip_screenshots: true,
      force: true,
      reject_if_possible: true,
      submit_for_review: true,
      automatic_release: true,
      phased_release: false,
      run_precheck_before_submit: false,
      release_notes: {
        "en-US" => release_notes
      },
      submission_information: {
        export_compliance_uses_encryption: false
      },
      api_key: api_key
    }
    upload_kwargs[:app_version] = version_name if version_name && !version_name.to_s.empty?

    begin
      upload_to_app_store(**upload_kwargs)
    rescue => e
      if e.message.include?("not in valid state") || e.message.include?("cannot be reviewed") || e.message.include?("whatsNew")
        UI.message("Binary uploaded successfully to App Store Connect. Retrying submission without blocking: #{e.message}")
        upload_kwargs[:submit_for_review] = false
        upload_to_app_store(**upload_kwargs)
      else
        UI.user_error!("Failed to upload/submit to App Store: #{e.message}")
      end
    end
  end
end
