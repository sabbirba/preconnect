{
  "name": "PreConnect Flutter DevContainer",
  "image": "ghcr.io/cirrusci/flutter:stable",
  "customizations": {
    "vscode": {
      "settings": {
        "dart.flutterSdkPath": "/sdks/flutter",
        "editor.formatOnSave": true
      },
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "remoteUser": "root"
}
