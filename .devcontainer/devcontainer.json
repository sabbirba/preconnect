{
  "name": "PreConnect",
  "image": "ghcr.io/cirrusci/flutter:stable",
  "customizations": {
    "vscode": {
      "settings": {
        "dart.flutterSdkPath": "/sdks/flutter",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        }
      },
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ]
    }
  },
  "postCreateCommand": "flutter pub get && [ -f .env ] || cp .env.example .env",
  "remoteUser": "root"
}
