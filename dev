#!/usr/bin/env bash
set -euo pipefail
# Simple wrapper to run commands with project Android env variables loaded.
ROOT="$(cd "$(dirname "$0")" && pwd)"
ENV_FILE="$ROOT/.env.local.sh"
if [ -f "$ENV_FILE" ]; then
  # shellcheck disable=SC1090
  source "$ENV_FILE"
fi
if [ $# -eq 0 ]; then
  echo "Usage: ./dev <command> [args...]"
  echo "Example: ./dev flutter run --dart-define-from-file=.env"
  exit 1
fi
exec "$@"
