import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:android_alarm_manager_plus/android_alarm_manager_plus.dart';
import 'package:do_not_disturb/do_not_disturb.dart';
import 'package:flutter_secure_storage/flutter_secure_storage.dart';
import 'package:http/http.dart' as http;

@pragma('vm:entry-point')
Future<void> enableDnd() async {
  final dnd = DoNotDisturbPlugin();
  if (await dnd.isNotificationPolicyAccessGranted()) {
    await dnd.setInterruptionFilter(InterruptionFilter.priority);
    print('DND ON');
  }
}

@pragma('vm:entry-point')
Future<void> disableDnd() async {
  final dnd = DoNotDisturbPlugin();
  if (await dnd.isNotificationPolicyAccessGranted()) {
    await dnd.setInterruptionFilter(InterruptionFilter.all);
    print('DND OFF');
  }
}

class DoNotDisturbPage extends StatefulWidget {
  @override
  State<DoNotDisturbPage> createState() => _DoNotDisturbPageState();
}

class _DoNotDisturbPageState extends State<DoNotDisturbPage> {
  final _storage = FlutterSecureStorage();
  final _dnd = DoNotDisturbPlugin();

  @override
  void initState() {
    super.initState();
    _initialize();
  }

  Future<void> _initialize() async {
    await _checkPermissions();
    await _fetchAndScheduleClasses();
  }

  Future<void> _checkPermissions() async {
    if (!await _dnd.isNotificationPolicyAccessGranted()) {
      await _dnd.openNotificationPolicyAccessSettings();
    }
  }

  Future<void> _fetchAndScheduleClasses() async {
    try {
      final portfolioId = await _storage.read(key: 'student_portfolio_id');
      final token = await _storage.read(key: 'access_token');

      final url = Uri.parse(
        'https://connect.bracu.ac.bd/api/adv/v1/student-courses/schedules?studentPortfolioId=$portfolioId',
      );
      final res = await http.get(
        url,
        headers: {
          'Authorization': 'Bearer $token',
          'User-Agent':
              'Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:136.0) Gecko/20100101 Firefox/136.0',
        },
      );

      if (res.statusCode == 200) {
        final List<dynamic> data = jsonDecode(res.body);
        await _scheduleWeeklyDnd(data);
        ScaffoldMessenger.of(
          context,
        ).showSnackBar(SnackBar(content: Text('Weekly DND schedule set.')));
      } else {
        print('API failed: ${res.statusCode}');
      }
    } catch (e) {
      print('Error: $e');
    }
  }

  Future<void> _scheduleWeeklyDnd(List<dynamic> courses) async {
    int alarmId = 100;

    for (final course in courses) {
      final scheduleJson = course['sectionSchedule'];
      if (scheduleJson == null) continue;

      final schedule = jsonDecode(scheduleJson);
      final List<dynamic> classSchedules = schedule['classSchedules'];
      if (classSchedules == null) continue;

      for (final classSlot in classSchedules) {
        final day = classSlot['day']; // e.g., "MONDAY"
        final start = classSlot['startTime']; // "12:30:00"
        final end = classSlot['endTime']; // "13:50:00"

        final weekday = _dayToInt(day);
        if (weekday == null) continue;

        final now = DateTime.now();
        final today = now.subtract(Duration(days: now.weekday - weekday));
        final startTime = _timeFromString(today, start);
        final endTime = _timeFromString(today, end);

        await AndroidAlarmManager.periodic(
          Duration(days: 7),
          alarmId++,
          enableDnd,
          startAt: startTime,
          exact: true,
          wakeup: true,
          rescheduleOnReboot: true,
        );

        await AndroidAlarmManager.periodic(
          Duration(days: 7),
          alarmId++,
          disableDnd,
          startAt: endTime,
          exact: true,
          wakeup: true,
          rescheduleOnReboot: true,
        );
      }
    }
  }

  DateTime _timeFromString(DateTime day, String time) {
    final parts = time.split(':').map(int.parse).toList();
    return DateTime(day.year, day.month, day.day, parts[0], parts[1]);
  }

  int? _dayToInt(String day) {
    const days = {
      'MONDAY': DateTime.monday,
      'TUESDAY': DateTime.tuesday,
      'WEDNESDAY': DateTime.wednesday,
      'THURSDAY': DateTime.thursday,
      'FRIDAY': DateTime.friday,
      'SATURDAY': DateTime.saturday,
      'SUNDAY': DateTime.sunday,
    };
    return days[day.toUpperCase()];
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text("Weekly DND")),
      body: Center(child: Text("DND will follow your class schedule.")),
    );
  }
}
