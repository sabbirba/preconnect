{
  "manifest_version": 3,
  "name": "PreConnect",
  "short_name": "PreConnect",
  "description": "PreConnect as a Chrome extension for BRACU students.",
  "version": "1.6.0",
  "action": {
    "default_title": "Open PreConnect",
    "default_icon": {
      "16": "icons/Icon-192.png",
      "32": "icons/Icon-192.png",
      "48": "icons/Icon-192.png",
      "128": "icons/Icon-512.png"
    }
  },
  "background": {
    "service_worker": "background.dart.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "https://sso.bracu.ac.bd/*",
    "https://connect.bracu.ac.bd/*",
    "https://api.preconnect.app/*",
    "https://files.preconnect.app/*",
    "https://api.github.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "icons": {
    "16": "icons/Icon-192.png",
    "32": "icons/Icon-192.png",
    "48": "icons/Icon-192.png",
    "128": "icons/Icon-512.png"
  }
}
