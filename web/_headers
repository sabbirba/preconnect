# Flutter service worker — must not be cached
/flutter_service_worker.js
  Cache-Control: no-cache, no-store, must-revalidate

# Flutter bootstrap script — must not be cached
/flutter.js
  Cache-Control: no-cache, no-store, must-revalidate

# Entry point — must not be cached so updates are picked up immediately
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed assets (main.dart.js, canvaskit, etc.) — cache forever, they never change
/main.dart.js
  Cache-Control: public, max-age=31536000, immutable

/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# WebAssembly — correct MIME type (some proxies serve it wrong)
/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

# PWA manifest
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

# Security headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
