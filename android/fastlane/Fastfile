default_platform(:android)

platform :android do
  desc "Submit a new Beta Build to Google Play Track"
  lane :upload_to_play_store do |options|
    aab_path = options[:aab]
    supply(
      aab: aab_path,
      track: "internal",
      release_status: "completed",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false
    )
  end

  desc "Promote internal track release to beta"
  lane :promote_to_beta do
    supply(
      track: "internal",
      track_promote_to: "beta",
      track_promote_release_status: "completed",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Promote beta release to production"
  lane :promote_beta_to_production do
    supply(
      track: "beta",
      track_promote_to: "production",
      track_promote_release_status: "completed",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
