opt_out_usage

default_platform(:android)

platform :android do
  desc "Upload a new build to the Google Play internal track"
  lane :play_store_upload do
    aab_path = ENV["AAB_PATH"]
    version_code = ENV["VERSION_CODE"] ? ENV["VERSION_CODE"].to_i : nil

    begin
      supply(
        aab: aab_path,
        version_code: version_code,
        track: "internal",
        release_status: "completed",
        in_app_update_priority: 3,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: false,
        changes_not_sent_for_review: true
      )
    rescue => e
      msg = e.message.to_s.downcase
      if msg.include?("cannot rollout this release") ||
         msg.include?("does not allow any existing users to upgrade") ||
         msg.include?("already been used") ||
         msg.include?("already exists") ||
         msg.include?("higher than") ||
         msg.include?("must be greater than") ||
         msg.include?("already in draft") ||
         msg.include?("already in use")
        UI.important("Google Play API Notice: #{e.message}. Pipeline skipping upload without failing.")
      else
        raise e
      end
    end
  end

  desc "Promote internal track release to production"
  lane :promote_internal_to_production do
    begin
      supply(
        track: "internal",
        track_promote_to: "production",
        track_promote_release_status: "completed",
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        changes_not_sent_for_review: true
      )
    rescue => e
      msg = e.message.to_s.downcase
      if msg.include?("cannot rollout this release") ||
         msg.include?("does not allow any existing users to upgrade") ||
         msg.include?("already been used") ||
         msg.include?("already exists") ||
         msg.include?("higher than") ||
         msg.include?("must be greater than") ||
         msg.include?("already in draft") ||
         msg.include?("already in use") ||
         msg.include?("release is already in the") ||
         msg.include?("already in production") ||
         msg.include?("already promoted") ||
         msg.include?("no track release") ||
         msg.include?("nothing to promote") ||
         msg.include?("cannot promote")
        UI.important("Google Play API Notice: #{e.message}. Pipeline skipping promotion without failing.")
      else
        raise e
      end
    end
  end
end
