opt_out_usage

default_platform(:android)

platform :android do
  desc "Upload a new build to the Google Play internal track"
  lane :play_store_upload do
    aab_path = ENV["AAB_PATH"]
    version_code = ENV["VERSION_CODE"] ? ENV["VERSION_CODE"].to_i : nil

    begin
      existing_codes = []
      ["internal", "alpha", "beta", "production"].each do |t|
        codes = google_play_track_version_codes(track: t) rescue nil
        existing_codes.concat(codes.map(&:to_i)) if codes.is_a?(Array)
      end
      existing_codes.uniq!

      if version_code && existing_codes.include?(version_code)
        UI.important("Version code #{version_code} already exists on Play Store. Skipping upload.")
        next
      end
    rescue => e
      UI.message("Could not fetch Play Store track version codes: #{e.message}. Proceeding with supply upload.")
    end

    begin
      supply(
        aab: aab_path,
        version_code: version_code,
        track: "internal",
        release_status: "completed",
        in_app_update_priority: 3,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: false
      )
    rescue => e
      msg = e.message.to_s.downcase
      if msg.include?("already been used") ||
         msg.include?("already exists") ||
         msg.include?("higher than") ||
         msg.include?("cannot rollout this release") ||
         msg.include?("does not allow any existing users to upgrade") ||
         msg.include?("must be greater than") ||
         msg.include?("already in draft") ||
         msg.include?("already in use")
        UI.important("Version code #{version_code} already uploaded or active on Play Store. Skipping upload without failing pipeline.")
      else
        raise e
      end
    end
  end

  desc "Promote internal track release to production"
  lane :promote_internal_to_production do
    version_code = ENV["VERSION_CODE"] && !ENV["VERSION_CODE"].empty? ? ENV["VERSION_CODE"].to_i : nil

    begin
      internal_codes = (google_play_track_version_codes(track: "internal") || []).map(&:to_i)
      production_codes = (google_play_track_version_codes(track: "production") || []).map(&:to_i)

      if version_code && production_codes.include?(version_code)
        UI.important("Version code #{version_code} is already in production. Skipping promotion.")
        next
      elsif version_code.nil? && internal_codes.any? && (internal_codes & production_codes).length == internal_codes.length
        UI.important("Internal track version codes #{(internal_codes & production_codes).join(", ")} are already in production. Skipping promotion.")
        next
      end
    rescue => e
      UI.message("Could not compare track version codes: #{e.message}. Proceeding with promotion.")
    end

    begin
      supply_opts = {
        track: "internal",
        track_promote_to: "production",
        track_promote_release_status: "completed",
        skip_upload_apk: true,
        skip_upload_aab: true,
        skip_upload_metadata: true,
        skip_upload_changelogs: true,
        skip_upload_images: true,
        skip_upload_screenshots: true
      }
      supply_opts[:version_code] = version_code if version_code
      supply(supply_opts)
    rescue => e
      msg = e.message.to_s.downcase
      if msg.include?("already been used") ||
         msg.include?("already exists") ||
         msg.include?("higher than") ||
         msg.include?("cannot rollout this release") ||
         msg.include?("does not allow any existing users to upgrade") ||
         msg.include?("must be greater than") ||
         msg.include?("already in draft") ||
         msg.include?("already in use") ||
         msg.include?("release is already in the") ||
         msg.include?("already promoted")
        UI.important("Release already promoted to production or no eligible release found. Skipping without failing pipeline.")
      else
        raise e
      end
    end
  end
end
